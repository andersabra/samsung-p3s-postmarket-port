# Reference: <https://postmarketos.org/vendorkernel>
# Maintainer: Anders <alchemistmedude@gmail.com>
pkgname=linux-samsung-p3s
pkgver=5.4.302
pkgrel=7
pkgdesc="Samsung Galaxy S21 Ultra (p3s) downstream kernel"
arch="aarch64"
_carch="arm64"
_flavor="samsung-p3s"
url="https://github.com/ProtonKernel/Proton"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash bc bison clang devicepkg-dev findutils flex lld llvm openssl-dev perl
"
_repository="Proton"
_commit="a0d73239d600d9ec89e7ac4775d2139d4d61290e"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/ProtonKernel/Proton/archive/$_commit.tar.gz
	$_config
	statx-add-mount-id.patch
	statx-add-mount-root.patch
	faccessat2.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	export CCACHE_DISABLE=1
	sed -i 's|#include <linux/compiler-gcc.h>|/* patched out compiler-gcc.h */|' \
		include/linux/compiler_types.h || true
	find drivers/sensorhub drivers/vision drivers/video/fbdev/exynos/panel/ea8082 \
                drivers/media/platform/exynos/camera \
		-name Makefile -exec sh -c 'echo "# disabled for pmOS" > "$1"' _ {} \;
	# (a sec_feat_uses_rbin stub used to be appended to kernel/panic.c here; with
	# proton_defconfig the real symbol is built, so the stub would be a duplicate)
	# Proton's Mali Kbuild lists the adaptive power policy as a .c instead of a .o,
	# so it is never compiled and mali_kbase.ko fails with an undefined symbol
	sed -i 's|backend/gpu/mali_kbase_pm_adaptive.c|backend/gpu/mali_kbase_pm_adaptive.o|' \
		drivers/gpu/arm/bv_r38p0/backend/gpu/Kbuild
	. downstreamkernel_prepare

	# downstreamkernel_prepare evaluates the config with gcc, which silently drops the
	# clang-only options ProtonPlus is built with (ThinLTO, shadow call stack).
	# Re-evaluate the original config with the same toolchain build() uses.
	cp "$srcdir/$_config" "$builddir/$_outdir/.config"
	make O="$_outdir" ARCH="$_carch" \
		CC="clang" \
		HOSTCC="gcc" \
		LD="ld.lld" \
		CLANG_TRIPLE="aarch64-linux-gnu-" \
		CROSS_COMPILE="aarch64-alpine-linux-musl-" \
		olddefconfig
	grep -E "^CONFIG_(CC_IS_CLANG|LTO_CLANG|THINLTO|SHADOW_CALL_STACK)=" "$_outdir/.config" || true
}

build() {
	export CCACHE_DISABLE=1
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" \
		CC="clang" \
		HOSTCC="gcc" \
		LD="ld.lld" \
		CLANG_TRIPLE="aarch64-linux-gnu-" \
		CROSS_COMPILE="aarch64-alpine-linux-musl-" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		Image modules
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	# the vendor drivers (clocks, pinctrl, PMIC, USB PHY, UFS...) are modules: ship them
	make O="$_outdir" ARCH="$_carch" \
		CC="clang" \
		HOSTCC="gcc" \
		LD="ld.lld" \
		CLANG_TRIPLE="aarch64-linux-gnu-" \
		CROSS_COMPILE="aarch64-alpine-linux-musl-" \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1 \
		modules_install
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source
}

