# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Anders <alchemistmedude@gmail.com>
pkgname=device-samsung-p3s
pkgver=1
pkgrel=19
pkgdesc="Samsung Galaxy S21 Ultra"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-mkbootimg
	linux-samsung-p3s
	postmarketos-base
	postmarketos-base-downstream
	reboot-mode
"
makedepends="devicepkg-dev linux-headers"
source="
	deviceinfo
	modules-initfs
	exynos2100-p3s.dtb
	modprobe-blacklist.conf
	p3s-init.sh
	samsung-p3s.files
	p3s-fbmirror.c
	p3s-console-size.c
	p3s-display.initd
	p3s-display.confd
	modules-load.conf
	networkmanager.conf
"
install="$pkgname.post-install $pkgname.post-upgrade"
options="!archcheck !check"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"

build() {
	devicepkg_build $startdir $pkgname
	${CC:-gcc} $CFLAGS -O2 -Wall -o "$srcdir"/p3s-fbmirror "$srcdir"/p3s-fbmirror.c $LDFLAGS
	${CC:-gcc} $CFLAGS -O2 -Wall -o "$srcdir"/p3s-console-size "$srcdir"/p3s-console-size.c $LDFLAGS
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/exynos2100-p3s.dtb \
		"$pkgdir"/boot/dtbs/exynos2100-p3s.dtb
	install -Dm644 "$srcdir"/modprobe-blacklist.conf \
		"$pkgdir"/etc/modprobe.d/samsung-p3s-blacklist.conf
	install -Dm755 "$srcdir"/p3s-init.sh \
		"$pkgdir"/usr/libexec/p3s-init.sh
	install -Dm644 "$srcdir"/samsung-p3s.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-samsung-p3s.files
	install -Dm755 "$srcdir"/p3s-fbmirror \
		"$pkgdir"/usr/libexec/p3s-fbmirror
	install -Dm755 "$srcdir"/p3s-console-size \
		"$pkgdir"/usr/bin/p3s-console-size
	install -Dm755 "$srcdir"/p3s-display.initd \
		"$pkgdir"/etc/init.d/p3s-display
	install -Dm644 "$srcdir"/modules-load.conf \
		"$pkgdir"/etc/modules-load.d/samsung-p3s.conf
	install -Dm644 "$srcdir"/networkmanager.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/50-samsung-p3s.conf
	install -Dm644 "$srcdir"/p3s-display.confd \
		"$pkgdir"/etc/conf.d/p3s-display
}

nonfree_firmware() {
	pkgdesc="Wi-Fi and Bluetooth firmware for Samsung Galaxy S21 Ultra (p3s)"
	depends="firmware-samsung-p3s"
	mkdir "$subpkgdir"
}

