# Maintainer: Anders <alchemistmedude@gmail.com>
pkgname=firmware-samsung-p3s
pkgver=1
pkgrel=0
pkgdesc="Proprietary Wi-Fi and Bluetooth firmware for Samsung Galaxy S21 Ultra (p3s)"
url="https://github.com/andersabra/firmware-samsung-p3s"
arch="aarch64"
license="proprietary"
options="!check !archcheck !strip !tracedeps pmb:cross-native"

_commit="68fd1a769bc6c2f3e924388acc49256eb83eb43a"
_repo="$url/raw/$_commit/vendor/firmware"

# BCM4389 Wi-Fi (dhd_bcm4389 requests these by name; it picks the _c0/_c1 firmware
# and the nvram variant from the chip's OTP data)
_files_wifi="
bcmdhd_sta.bin_c0
bcmdhd_sta.bin_c1
bcmdhd_clm.blob
nvram.txt
nvram.txt_1wk_es40_c0
nvram.txt_1wk_es41_c0
nvram.txt_1wk_es42_c0
nvram.txt_1wk_es43_c0
nvram.txt_4389_3321
nvram.txt_4389_3323
nvram.txt_4389_3332
nvram.txt_ES30_semco_c0
nvram.txt_ES32_semco_c0
nvram.txt_ES40_semco_c1
"

# BCM4389 Bluetooth patch RAM
_files_bt="
bcm4389B0_murata.hcd
bcm4389B0_semco.hcd
bcm4389C0_murata.hcd
bcm4389C0_semco.hcd
bcm4389C1_murata.hcd
bcm4389C1_semco.hcd
"

for _f in $_files_wifi; do
	source="$source $pkgname-$_commit-$_f::$_repo/wifi/$_f"
done
for _f in $_files_bt; do
	source="$source $pkgname-$_commit-$_f::$_repo/$_f"
done

package() {
	local _f
	for _f in $_files_wifi $_files_bt; do
		install -Dm644 "$srcdir/$pkgname-$_commit-$_f" "$pkgdir/lib/firmware/$_f"
	done
}

